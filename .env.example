# ==============================
# Database (Prisma 7)
# ==============================
DATABASE_URL=


# ==============================
# NextAuth
# ==============================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=YOUR_RANDOM_SECRET
AUTH_TRUST_HOST=true


# ==============================
# Google OAuth
# ==============================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET


# ==============================
# GitHub OAuth
# ==============================
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET


# ==============================
# OpenRouter
# ==============================
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Private Vercel Blob store, connected to this project. Pull for local development
# with `vercel env pull`. Client uploads require BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=


# ==============================
# Redis
# ==============================
REDIS_URL=redis://localhost:6379


# ==============================
# Qdrant
# ==============================
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chatterstack_memory
QDRANT_ENDPOINT=YOUR_QDRANT_CLOUD_ENDPOINT


# ==============================
# RAG Config
# ==============================
RAG_ENABLED=true
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K_DENSE=10
RAG_TOP_K_SPARSE=10
RAG_TOP_K_FINAL=5
RAG_TIME_WINDOW_DAYS=90


# ==============================
# Embeddings
# ==============================
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_CACHE_TTL=86400


# ==============================
# Profile
# ==============================
PROFILE_UPDATE_THRESHOLD=5
PROFILE_REFRESH_CRON=0 2 * * *


# ==============================
# LLM observability (OpenObserve) - optional
# ==============================
# Every model call (chat, council stages, titles, embeddings) can be recorded
# for latency, token, cost and failure analysis. Nothing is sent unless both a
# URL and credentials are present.
OPENOBSERVE_URL=
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=
OPENOBSERVE_PASSWORD=
# Alternative to user + password: a ready Basic token, or a user:password pair.
OPENOBSERVE_AUTH=
OPENOBSERVE_STREAM=llm_calls
# true stores truncated prompts and answers (2,000 characters each, never
# attachment bytes) in OpenObserve. Off by default; leave off unless you
# accept that user content lands in that stream.
OPENOBSERVE_LOG_CONTENT=false
