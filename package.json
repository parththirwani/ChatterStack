{
  "name": "chatterstack-workspace",
  "private": true,
  "workspaces": ["apps/web", "apps/auth", "apps/chat"],
  "scripts": {
    "dev": "npm run dev --workspace @chatterstack/web",
    "build": "npm run build --workspace @chatterstack/web",
    "build:auth": "npm run build --workspace @chatterstack/auth",
    "build:chat": "npm run build --workspace @chatterstack/chat",
    "build:vercel": "npm run build:vercel --workspace @chatterstack/web",
    "start": "npm run start --workspace @chatterstack/web",
    "lint": "npm run lint --workspace @chatterstack/web",
    "typecheck": "npm run typecheck --workspace @chatterstack/web",
    "test:static": "npm run test:static --workspace @chatterstack/web && npm run typecheck --workspace @chatterstack/auth && npm run typecheck --workspace @chatterstack/chat",
    "test:unit": "npm run test:unit --workspace @chatterstack/web",
    "test:integration": "npm run test:integration --workspace @chatterstack/web",
    "test:models": "npm run test:models --workspace @chatterstack/web",
    "test:vitest": "npm run test:vitest --workspace @chatterstack/web",
    "test:services": "node scripts/smoke-services.mjs",
    "test:e2e": "npm run test:e2e --workspace @chatterstack/web",
    "test": "npm run test --workspace @chatterstack/web",
    "db:push": "npm exec --workspace @chatterstack/web -- prisma db push"
  },
  "engines": { "node": "24.x" }
}
