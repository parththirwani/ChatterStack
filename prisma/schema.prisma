datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  
  // Make custom fields OPTIONAL
  provider       String?
  providerId     String?
  avatarUrl      String?
  profile        Json?
  profileUpdated DateTime?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  conversations   Conversation[]
  documents       Document[]
  skills          Skill[]
  scheduledTasks  ScheduledTask[]
  mcpConnections  McpConnection[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Conversation {
  id        String    @id @default(uuid())
  title     String?
  userId    String
  // Set when the user pins the chat; pinned chats sort first, most recent pin on top.
  pinnedAt  DateTime?
  // Set on a scheduled task's run chats, which stay out of Recents. Cleared
  // when the task is deleted, so its runs become ordinary chats.
  scheduledTaskId String?
  // Where a forked chat came from: the source chat and the message it was cut
  // at. Plain ids, not relations, so a fork outlives its source.
  parentConversationId String?
  forkedFromMessageId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledTask ScheduledTask? @relation(fields: [scheduledTaskId], references: [id], onDelete: SetNull)
  messages      Message[]
  contextSnapshot ConversationContextSnapshot?

  @@index([userId, scheduledTaskId])
  @@index([parentConversationId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  content        String       @db.Text
  role           String
  modelId        String?
  attachments    Json?
  // Skills tagged on a user message: [{ id, name }]. References only, so
  // later edits to a skill don't rewrite history.
  skills         Json?
  // Order within the conversation, 1-based. createdAt ties or lands out of
  // order (rows are saved together), so history and forks order by this.
  // Null only on rows saved before the column existed; see
  // scripts/backfill-message-positions.mjs.
  position       Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@index([conversationId, modelId])
  @@unique([conversationId, position])
  @@map("messages")
}

/**
 * The portable compaction state for one conversation. Message rows remain the
 * source of truth and the UI transcript; this row only supplies the summary
 * the model sees for everything up to `throughMessageId`.
 */
model ConversationContextSnapshot {
  id                String   @id @default(uuid())
  conversationId    String   @unique
  summaryText       String   @db.Text
  // Last message covered by the summary; a completed turn boundary.
  throughMessageId  String
  // Hash of the source messages, so a stale snapshot is detectable.
  sourceHash        String
  // Optimistic concurrency: bumped on every successful summary update.
  version           Int      @default(1)
  schemaVersion     Int      @default(1)
  summaryModelId    String
  inputTokensBefore Int
  inputTokensAfter  Int
  summaryTokens     Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_context_snapshots")
}

model Document {
  id          String    @id @default(uuid())
  userId      String
  name        String
  mimeType    String
  size        Int
  sha256      String
  storageKey  String    @unique
  favoritedAt DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sha256])
  @@index([userId, lastUsedAt])
  @@map("documents")
}

model Skill {
  id           String   @id @default(uuid())
  userId       String
  // Kebab-case slug; what the user types after "/" in the composer.
  name         String
  description  String
  // The SKILL.md body (without frontmatter).
  instructions String   @db.Text
  // created | generated (from a chat) | uploaded | catalog (added from Discover)
  source       String   @default("created")
  // Turned-off skills stay saved but are not offered in chat.
  enabled      Boolean  @default(true)
  categories   String[] @default([])
  // Other text files in the skill: [{ path, content }].
  files        Json?
  // Frontmatter keys other than name and description, kept for export.
  metadata     Json?
  // Bumped on every content change.
  version      Int      @default(1)
  // Discover catalog entry this skill was added from.
  catalogId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("skills")
}

model ScheduledTask {
  id            String    @id @default(uuid())
  userId        String
  name          String
  // Sent as the user message on every run.
  prompt        String    @db.Text
  model         String
  thinkingLevel String    @default("medium")
  // manual | hourly | daily | weekdays | weekly
  frequency     String
  // "HH:MM" in `timezone`; hourly uses only the minutes.
  time          String    @default("09:00")
  // 0 (Sunday) - 6, for weekly.
  weekday       Int       @default(1)
  // IANA zone the times are in, from the user's browser.
  timezone      String
  // Paused tasks keep their settings but don't run on schedule.
  enabled       Boolean   @default(true)
  // Null for manual and paused tasks. The scheduler claims tasks by this.
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs          ScheduledTaskRun[]
  conversations Conversation[]

  @@index([enabled, nextRunAt])
  @@index([userId])
  @@map("scheduled_tasks")
}

model ScheduledTaskRun {
  id             String    @id @default(uuid())
  taskId         String
  // schedule | manual (Run now)
  trigger        String
  // running | succeeded | failed | skipped
  status         String
  // Why the run failed or was skipped.
  error          String?
  // The run's chat; null when the run was skipped before it started.
  conversationId String?
  // The scheduled time this run was for (null for Run now).
  scheduledFor   DateTime?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  task ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
  @@index([status, startedAt])
  @@map("scheduled_task_runs")
}

/**
 * A user's remote MCP server. Credentials are encrypted with MCP_CREDENTIAL_KEY
 * and are never returned by any API response. Tool metadata comes from the
 * server and is treated as untrusted.
 */
model McpConnection {
  id            String    @id @default(uuid())
  userId        String
  name          String
  // Catalog entry this connection was prefilled from; null for a custom URL.
  catalogId     String?
  url           String
  // Only streamable_http is supported in this release.
  transport     String    @default("streamable_http")
  // none | bearer
  authMode      String    @default("none")
  // AES-256-GCM material for the bearer token; null when authMode is none.
  credential    String?
  // Off until the user turns it on; a tool-free connection changes nothing.
  enabled       Boolean   @default(false)
  // untested | connected | error
  status        String    @default("untested")
  // Redacted reason for the last failure, safe to show.
  lastError     String?
  lastCheckedAt DateTime?
  // Discovered tools: [{ id, name, description, readOnly, schemaBytes }].
  tools         Json?
  // Hash of the discovered tool list; a mismatch means re-review is required.
  toolsDigest   String?
  // Digest the user last reviewed before enabling.
  reviewedDigest String?
  // Per-tool enablement: { "<server tool name>": true }.
  toolEnabled   Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, enabled])
  @@map("mcp_connections")
}
